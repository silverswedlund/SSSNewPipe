<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/blocked_channels_help_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:text="@string/blocked_channels_help"
        android:textAppearance="?android:attr/textAppearanceSmall" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/blocked_channels_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/blocked_channels_help_text"
        tools:listitem="@layout/item_blocked_channel" />

    <org.schabi.newpipe.views.NewPipeTextView
        android:id="@+id/empty_state_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/no_blocked_channels"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:visibility="gone"
        tools:visibility="visible" />
</RelativeLayout>
